---
import BaseLayout from "../layouts/BaseLayout.astro";
import Eyebrow from "../components/Eyebrow.astro";

const title = "Terms of Service";
const description = "Terms of service for Texas Movement Media. Full terms text is pending.";
---

<BaseLayout title={title} description={description} path="/terms">
  <section class="section">
    <div class="wrap">
      <Eyebrow>Legal</Eyebrow>
      <h1>Terms of Service</h1>
      <div class="notice">
        <p>
          <strong>Policy content pending.</strong> Texas Movement Media has not yet published finalized terms of
          service for this property. This page is a placeholder so the route exists and is linked honestly from the
          footer &mdash; it does not represent real legal text. See <code>docs/LAUNCH_BLOCKERS.md</code> for status.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
